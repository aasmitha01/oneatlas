generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  website     String?
  logo        String?
  models      AIModel[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIModel {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  family          String?
  description     String
  modelType       String           @default("Text")
  contextWindow   Int              @default(0)
  releaseDate     DateTime?
  inputModalities String[]         @default([])
  outputModalities String[]        @default([])
  capabilities    String[]         @default([])
  featured        Boolean          @default(false)
  companyId       String?
  company         Company?         @relation(fields: [companyId], references: [id])
  providers       ModelProvider[]
  benchmarks      ModelBenchmark[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  @@index([companyId])
  @@index([modelType])
}

model Provider {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  website     String?
  models      ModelProvider[]
  createdAt   DateTime        @default(now())
}

model ModelProvider {
  id              String        @id @default(cuid())
  modelId         String
  providerId      String
  providerModelId String?
  isAvailable     Boolean       @default(true)
  model           AIModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  pricing         ModelPricing[]
  @@unique([modelId, providerId])
  @@index([providerId])
}

model ModelPricing {
  id                    String        @id @default(cuid())
  modelProviderId       String
  inputPricePerMillion  Decimal       @db.Decimal(12, 6)
  outputPricePerMillion Decimal       @db.Decimal(12, 6)
  currency              String        @default("USD")
  modelProvider         ModelProvider @relation(fields: [modelProviderId], references: [id], onDelete: Cascade)
  updatedAt             DateTime      @updatedAt
}

model ModelBenchmark {
  id            String   @id @default(cuid())
  modelId       String
  benchmarkName String
  score         Float
  scoreUnit     String?
  source        String?
  evaluatedAt   DateTime?
  model         AIModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  @@index([modelId, benchmarkName])
}
